# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth
NEXTAUTH_SECRET="<generate with: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"

# API Tokens (INTERNAL USE ONLY - NEVER COMMIT)
KIYOH_API_TOKEN="your-kiyoh-api-token"
KLANTENVERTELLEN_API_TOKEN="your-klantenvertellen-api-token"

# Node Environment
NODE_ENV="development"
